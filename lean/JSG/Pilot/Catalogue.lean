/-- A manuscript's folder under `preprints/`. -/
def folder : Fin size → String := nth folders (by decide +kernel)

/-- A manuscript's title. -/
def title : Fin size → String := nth titles (by decide +kernel)

/-- A manuscript's family in `CONTENTS.md`, if it's listed there. -/
def family : Fin size → Option String := nth families (by decide +kernel)

/-- Our Comparator runs on the catalogue's challenges, as the report states them. -/
def comparatorNote : String :=
  "Comparator, in our [run 40916190535](https://github.com/marleymcwilliams/LibSpec" ++
    "/actions/runs/40916190535), accepted `Catalan`, `BogomolovPopInjectivity`, " ++
    "`DeligneDrinfeld` and `JointDickman`. That run isn't trusted yet, since the " ++
    "release's lakefile ran outside Comparator's sandbox, on the same machine, before" ++
    " Comparator did (#83). So its results are measurements, and no challenge counts " ++
    "as run."

/-- The catalogue as a release: each manuscript's raw facts, and the manuscripts its withdrawal
    notice links to. -/
def release : Release size where
  raw := nth raws (by decide +kernel)
  deps := nth links (by decide +kernel)

