{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["instruments"],
  "properties": {
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "hash"],
        "properties": {
          "name": {"type": "string"},
          "version": {"type": "string"},
          "description": {"type": "string"},
          "hash": {"type": "string"}
        }
      }
    }
  }
}
